# Maintainer: Alfred Keller <7837789+alfredch@users.noreply.github.com>
#
# Named nudge-desktop because "nudge" is taken in the AUR by an unrelated
# app that also installs /usr/bin/nudge.

pkgname=nudge-desktop
_name=nudge
pkgver=0.1.0
pkgrel=1
pkgdesc="Unofficial Pushover Open Client for the Linux desktop (not supported by Pushover)"
arch=('x86_64' 'aarch64')
url="https://github.com/alfredch/nudge"
license=('MIT OR Apache-2.0')
depends=('alsa-lib' 'glibc' 'hicolor-icon-theme' 'libgcc')
makedepends=('cargo')
optdepends=(
  'wl-clipboard: Copy button on Wayland'
  'xclip: Copy button on X11'
  'gnome-shell-extension-appindicator: tray icon on GNOME'
)
# makepkg's LTO turns aws-lc's C objects into GCC bitcode the Rust linker
# cannot read (undefined aws_lc_* symbols); Cargo's own LTO stays on.
# No debug package: the release profile already strips symbols.
options=('!lto' '!debug')
provides=("$_name")
conflicts=("$_name")
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p nudge
}

check() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen -p nudge-api -p nudge
}

package() {
  cd "$_name-$pkgver"
  install -Dm755 target/release/nudge -t "$pkgdir/usr/bin/"
  install -Dm644 packaging/nudge.service -t "$pkgdir/usr/lib/systemd/user/"
  install -Dm644 packaging/io.github.alfredch.Nudge.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/icons/scalable/apps/io.github.alfredch.Nudge.svg \
    -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 packaging/icons/symbolic/apps/*.svg -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps/"
  install -Dm644 packaging/config.toml "$pkgdir/usr/share/doc/$pkgname/config.toml.example"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
